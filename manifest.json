{
  "manifest_version": 3,
  "name": "Stock Market Analysis",
  "version": "1.0",
  "description": "A Chrome extension for stock market analysis with ticker fetching capability",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://finviz.com/*",
    "https://*.finviz.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://finviz.com/*"],
      "js": ["content.js"]
    }
  ]
}
